{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["pdx1"],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Accept-CH",
          "value": "Sec-CH-UA-Mobile, Sec-CH-Viewport-Width"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/api/plugins/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, s-maxage=300"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=60, s-maxage=300"
        }
      ]
    },
    {
      "source": "/api/oauth/client-metadata/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "images": {
    "sizes": [64, 128, 256, 384, 640, 1080, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2592000,
    "localPatterns": [
      {
        "pathname": "^/assets/.*$",
        "search": ""
      }
    ]
  },
  "functions": {
    "src/app/api/**/route.ts": {
      "memory": 512
    },
    "src/app/api/v1/plugins/install/route.ts": {
      "memory": 512,
      "maxDuration": 60
    },
    "src/app/api/v1/chats/**/generate/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "src/app/api/chat/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "src/app/api/v1/agent/**/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "src/app/api/v1/sandbox/**/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "src/app/api/v1/novita/**/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "src/app/api/shirova/**/route.ts": {
      "memory": 1024,
      "maxDuration": 300
    },
    "src/app/api/projects/**/files/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/audio/dictation/**/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/customize/skills/upload/route.ts": {
      "maxDuration": 60
    }
  }
}
