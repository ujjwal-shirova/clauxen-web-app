# Environment variables template
# Copy to `.env.local` for local development.

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:9002
AUTH_DEV_BYPASS=true
# Set false in production — requires Supabase GoTrue sessions
AUTH_REQUIRED_FOR_CHAT=false

# =============================================================================
# Supabase (Postgres + GoTrue)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# =============================================================================
# Cloudflare R2 (object storage)
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_IMAGES_BUCKET=clauxen-images
R2_DOCUMENTS_BUCKET=clauxen-documents
R2_ARTIFACTS_BUCKET=clauxen-artifacts
R2_SKILLS_BUCKET=clauxen-skills
R2_CHAT_ARCHIVES_BUCKET=clauxen-chat-archives
# Optional public CDN base for signed URLs
R2_PUBLIC_BASE_URL=

# =============================================================================
# Cloudflare Worker (R2 gateway — presign / download / delete)
# =============================================================================
WORKER_URL=https://r2-gateway.YOUR_SUBDOMAIN.workers.dev

# =============================================================================
# Inference (Novita)
# =============================================================================
NOVITA_AI_KEY=
NOVITA_ANTHROPIC_BASE_URL=
NOVITA_OPENAI_BASE_URL=

# =============================================================================
# Billing (Razorpay)
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# =============================================================================
# Optional integrations
# =============================================================================
EXA_API_KEY=
REDIS_URL=
JWT_SECRET=dev-jwt-secret-change-me
