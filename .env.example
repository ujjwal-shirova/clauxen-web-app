# App
NEXT_PUBLIC_APP_URL=http://localhost:9002
# Comma-separated LAN hostnames/IPs allowed for Next.js dev HMR (optional; local IPs are auto-detected)
# ALLOWED_DEV_ORIGINS=192.168.29.120
AUTH_REQUIRED_FOR_CHAT=false
NEXT_PUBLIC_AUTH_REQUIRED_FOR_CHAT=false
AUTH_DEV_BYPASS=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shirova server-side inference gateway
# Server-only Vercel/Node env. Never expose this with NEXT_PUBLIC_.
NOVITA_AI_KEY=
# Legacy alias (optional if NOVITA_AI_KEY is set)
NOVITA_API_KEY=
SHIROVA_DEFAULT_MODEL=moonshotai/kimi-k2.6
# Kimi thinking: enabled | disabled (mapped to Novita enable_thinking)
SHIROVA_THINKING_TYPE=disabled
SHIROVA_NOVITA_CHAT_COMPLETIONS_URL=https://api.novita.ai/openai/chat/completions
# Novita Agent Sandbox recipes use these names in generated Python runtimes.
E2B_DOMAIN=sandbox.novita.ai
E2B_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.novita.ai/openai
LLM_MODEL=minimax/minimax-m2

# Novita OpenAI-compatible base URL
NOVITA_OPENAI_BASE_URL=https://api.novita.ai/openai
NOVITA_MODELS_URL=https://api.novita.ai/openai/v1/models
NOVITA_SANDBOX_TIMEOUT_MS=300000

BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=

NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CockroachDB — see cockroachdb/README.md and docs/backend.md
COCKROACH_DATABASE_URL=

# Ory (optional — docker compose -f infra/ory/docker-compose.yml up)
NEXT_PUBLIC_ORY_AUTH_ENABLED=false
ORY_KRATOS_PUBLIC_URL=http://127.0.0.1:4433
ORY_KRATOS_ADMIN_URL=http://127.0.0.1:4434
ORY_KRATOS_WEBHOOK_SECRET=
ORY_HYDRA_PUBLIC_URL=http://127.0.0.1:4444
ORY_HYDRA_ADMIN_URL=http://127.0.0.1:4445
ORY_HYDRA_CLIENT_ID=clauxen-web
ORY_HYDRA_CLIENT_SECRET=
ORY_HYDRA_REDIRECT_URI=http://localhost:9002/api/v1/auth/callback

# AI providers
FAL_KEY=
PARALLEL_API_KEY=
