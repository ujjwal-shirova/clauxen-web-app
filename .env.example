# Environment variables template
# Copy to `.env.local` for local development.
# NEVER prefix secrets with NEXT_PUBLIC_ — those are embedded in the browser bundle.

# =============================================================================
# App (public — safe in browser)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:9002
NEXT_PUBLIC_AUTH_REQUIRED_FOR_CHAT=true

# =============================================================================
# App (server-only)
# =============================================================================
# Local cookie bypass only — ignored on Vercel / production (always false).
AUTH_DEV_BYPASS=true
# Fail closed by default; set false only for intentional anonymous chat experiments.
AUTH_REQUIRED_FOR_CHAT=true
STORAGE_REQUIRE_R2=false

# =============================================================================
# Supabase (Postgres + GoTrue)
# =============================================================================
# Keep the canonical project URL as the runtime endpoint. A paid custom domain
# may be registered with OAuth providers too, but must not replace this value.
NEXT_PUBLIC_SUPABASE_URL=https://ntplcfsbcyhiqklkbldk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Do not duplicate as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — use ANON_KEY only.
# Server-only — NEVER expose in browser:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use the Supabase transaction pooler for Vercel/serverless traffic.
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
# Keep one checked-out connection per serverless isolate unless capacity is
# intentionally increased with a matching Supabase pool budget.
DATABASE_POOL_MAX=1

# =============================================================================
# Cloudflare R2 (server-only)
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_API_TOKEN=
CLOUDFLARE_API_TOKEN=
R2_IMAGES_BUCKET=clauxen-images
R2_ATTACHMENTS_BUCKET=clauxen-user-attachments
R2_DOCUMENTS_BUCKET=clauxen-documents
R2_ARTIFACTS_BUCKET=clauxen-artifacts
R2_SKILLS_BUCKET=clauxen-skills
R2_CHAT_ARCHIVES_BUCKET=clauxen-chat-archives
R2_USER_FILES_BUCKET=clauxen-documents
# Dictation chunk storage; falls back to R2_DOCUMENTS_BUCKET when unset.
R2_AUDIO_RECORDINGS_BUCKET=clauxen-documents
R2_PUBLIC_BASE_URL=

# =============================================================================
# Cloudflare Worker (R2 gateway)
# =============================================================================
WORKER_URL=https://r2-gateway.YOUR_SUBDOMAIN.workers.dev

# =============================================================================
# Cloudflare Worker (chat-history edge cache — Cache API → KV → fresh Hyperdrive)
# =============================================================================
NEXT_PUBLIC_CHAT_HISTORY_WORKER_URL=https://clauxen-chat-history.YOUR_SUBDOMAIN.workers.dev
CHAT_HISTORY_WORKER_URL=https://clauxen-chat-history.YOUR_SUBDOMAIN.workers.dev
CHAT_HISTORY_INTERNAL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# =============================================================================
# Cloudflare Worker (chat-coord — Durable Object generation lease per chatId)
# =============================================================================
CHAT_COORD_WORKER_URL=https://clauxen-chat-coord.YOUR_SUBDOMAIN.workers.dev
CHAT_COORD_INTERNAL_TOKEN=

# =============================================================================
# Cloudflare Worker (horizontal OAuth connector and agent tool gateway)
# CONNECTOR_ENCRYPTION_KEY and CONNECTOR_GATEWAY_ADMIN_TOKEN live only on CF.
# =============================================================================
CONNECTOR_GATEWAY_URL=https://clauxen-connector-gateway.ujjwal-8fc.workers.dev
CONNECTOR_GATEWAY_INTERNAL_TOKEN=

# Optional split secret for sealing gateway-less MCP API keys (AES-256).
# 64-char hex or base64url 32 bytes. When unset, keys are sealed with a
# sub-key derived from SUPABASE_SERVICE_ROLE_KEY (zero-config default).
# PLUGIN_CREDENTIAL_KEY=

# Vercel Edge Config connection string (flags / model kill-switch)
EDGE_CONFIG=

# =============================================================================
# Cloudflare Worker (auth-email — OTP via Email Service + KV)
# Onboard domain under Email Service → Email Sending, then wrangler deploy.
# =============================================================================
AUTH_EMAIL_WORKER_URL=https://clauxen-auth-email.YOUR_SUBDOMAIN.workers.dev
AUTH_EMAIL_INTERNAL_TOKEN=

# Cloudflare billing Worker (Razorpay proxy + invoice PDF → R2)
# Prefer this for server-side payment orchestration. Keys can live only on CF.
BILLING_WORKER_URL=https://clauxen-billing.YOUR_SUBDOMAIN.workers.dev
BILLING_INTERNAL_TOKEN=
# Production: fail closed if the billing Worker is unreachable (no direct Razorpay from Vercel).
BILLING_REQUIRE_WORKER=true

# Scheduled tasks cron (Cloudflare Worker → Vercel dispatch)
# Same token on Worker secrets + Vercel Production/Preview.
SCHEDULED_TASKS_INTERNAL_TOKEN=
# Optional: APP_ORIGIN for the Worker (defaults to https://clauxen.com)

# =============================================================================
# Inference provider (server-only — NEVER prefix with NEXT_PUBLIC_)
# Set these in Vercel as Sensitive. Browser must never see them.
# =============================================================================
Provider_API_Key=
Provider_BASE_URL=https://api.novita.ai/openai
Provider_SANDBOX_TIMEOUT_MS=300000
Provider_Model_Virgil=qwen/qwen3.8-flash
Provider_Model_Homer=qwen/qwen3.8-2.4t-a95b
Provider_Model_Helios=moonshotai/kimi-k2.6
# Legacy fallback only; new deployments should use the three variables above.
Provider_Model_Clauxen_V1=
SHIROVA_THINKING_TYPE=disabled

# =============================================================================
# Search & tools (server-only)
# =============================================================================
EXA_API_KEY=
# AssemblyAI realtime dictation (server mints single-use streaming tokens).
Assembly_Provider_Key=
# Optional override; default streaming.assemblyai.com
# ASSEMBLYAI_STREAMING_HOST=streaming.assemblyai.com
FAL_KEY=
PARALLEL_API_KEY=
GOOGLE_PLACES_API_KEY=

# =============================================================================
# Billing — Razorpay
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public checkout key only — safe for Razorpay.js in browser:
NEXT_PUBLIC_RAZORPAY_KEY_ID=
CHECKOUT_USD_INR_RATE=
APPLE_PAY_DOMAIN_ASSOCIATION=
# AES-256 key for encrypting Razorpay card/token refs (never PAN).
# Prefer 64-char hex. Passphrases are SHA-256 hashed to 32 bytes.
PAYMENT_METHOD_ENCRYPTION_KEY=

# =============================================================================
# Queue & auth (server-only)
# =============================================================================
REDIS_URL=
JWT_SECRET=

# X / Twitter OAuth 2.0 — used by scripts/enable-x-auth.mjs (NOT Next.js runtime).
# Configure the provider in Supabase Dashboard or run the enable script.
# SUPABASE_ACCESS_TOKEN=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# SUPABASE_PROJECT_REF=ntplcfsbcyhiqklkbldk

# =============================================================================
# Cursor MCP (Cloud Agents / CI) — never commit real values
# Referenced from .cursor/mcp.json as ${env:VAR}. Create tokens at:
#   VERCEL_TOKEN            https://vercel.com/account/tokens (full access)
#   SUPABASE_ACCESS_TOKEN   https://supabase.com/dashboard/account/tokens (full scopes)
#   CLOUDFLARE_API_TOKEN    https://dash.cloudflare.com/profile/api-tokens (see scopes below)
# Add these same names as Secrets in Cursor Dashboard → Cloud Agents → Secrets
# so autonomous agents authenticate headlessly. The Supabase MCP URL enables all
# feature groups (account,database,docs,debugging,development,functions,branching,storage).
# Cloudflare token needs (Account scope, Edit unless noted): Workers Scripts,
# Workers KV Storage, Workers R2 Storage, D1, Hyperdrive, Queues, Vectorize,
# Workers Routes, Pages, Durable Objects, Workers Observability (Read), Logs (Read),
# Account Settings (Read, for account auto-detect).
# =============================================================================
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
# CLOUDFLARE_API_TOKEN is defined in the Cloudflare R2 section above.

# =============================================================================
# Sandbox (optional)
# =============================================================================
E2B_API_KEY=
E2B_DOMAIN=
