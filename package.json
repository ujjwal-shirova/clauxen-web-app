{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <27",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=DEP0205' next dev -p 9002",
    "build": "next build",
    "vercel-build": "prisma generate && next build",
    "start": "NODE_OPTIONS='--disable-warning=DEP0205' next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:db:push": "supabase db push",
    "supabase:blocked-emails:seed": "tsx scripts/seed-blocked-email-domains.ts",
    "supabase:functions:deploy": "supabase functions deploy",
    "supabase:functions:list": "supabase functions list",
    "crdb:apply-app": "node cockroachdb/scripts/apply-app-schema.mjs",
    "crdb:reset": "node cockroachdb/scripts/reset-crdb-databases.mjs",
    "crdb:apply-native": "COCKROACH_SKIP_POLICIES=1 node cockroachdb/scripts/apply-native-migrations-crdb.mjs",
    "crdb:apply-native:full": "node cockroachdb/scripts/apply-native-migrations-crdb.mjs",
    "crdb:molt-load": "node cockroachdb/scripts/run-molt-data-load.mjs",
    "crdb:molt-schema": "COCKROACH_MOLT_SCHEMA_ONLY=1 node cockroachdb/scripts/run-molt-data-load.mjs",
    "crdb:schema-fast": "node cockroachdb/scripts/run-molt-schema-fast.mjs",
    "crdb:verify-schema": "node cockroachdb/scripts/verify-schema-parity.mjs",
    "crdb:molt-data": "COCKROACH_MOLT_TABLE_HANDLING=truncate-if-exists node cockroachdb/scripts/run-molt-data-load.mjs",
    "crdb:apply-shim": "node cockroachdb/scripts/apply-shim-crdb.mjs",
    "crdb:migrate": "npm run crdb:reset && npm run crdb:apply-shim && npm run crdb:molt-load && npm run crdb:migrate:python",
    "crdb:migrate:python": "cockroachdb/.venv/bin/python cockroachdb/scripts/migrate_parallel.py",
    "crdb:venv": "python3 -m venv cockroachdb/.venv && cockroachdb/.venv/bin/pip install -r cockroachdb/requirements-migrate.txt",
    "crdb:apply-migrations": "node cockroachdb/scripts/apply-supabase-migrations-crdb.mjs",
    "crdb:apply-fast": "COCKROACH_FAST=1 COCKROACH_DEFER_INDEXES=1 node cockroachdb/scripts/apply-supabase-migrations-crdb.mjs",
    "crdb:apply-schema": "COCKROACH_SCHEMA_ONLY=1 node cockroachdb/scripts/apply-supabase-migrations-crdb.mjs",
    "crdb:apply-migrations:verbose": "COCKROACH_VERBOSE=1 node cockroachdb/scripts/apply-supabase-migrations-crdb.mjs",
    "crdb:prepare-upload-sql": "node cockroachdb/scripts/prepare-crdb-upload-sql.mjs",
    "crdb:seed-plans": "node cockroachdb/scripts/seed-plans.mjs",
    "strip:annotations": "node .tools/strip-hindi-annotations.mjs",
    "worker": "tsx scripts/worker.ts",
    "autonomous-agent:ws": "tsx src/autonomous-agent/scripts/ws-server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "tsx --test src/**/*.test.ts"
  },
