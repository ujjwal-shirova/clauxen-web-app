# Copy to `.env.local` in this folder (gitignored) and fill in values.
# Never commit real passwords or connection strings.

# Postgres-compatible URL for CockroachDB (SQL clients + most drivers).
# Path segment after the host is the database name (e.g. Clauxen-Database-Main after migrations).
COCKROACH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/DATABASE?sslmode=verify-full

# Optional (local dev only): if Node/pg cannot validate verify-full, set to 0.
# COCKROACH_SSL_REJECT_UNAUTHORIZED=0
