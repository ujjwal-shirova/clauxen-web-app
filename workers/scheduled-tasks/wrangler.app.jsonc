{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clauxen-app-scheduled-tasks",
  "main": "src/index.ts",
  "account_id": "8fc7a67e9057989309921f362784ecf4",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "vars": { "APP_ORIGIN": "https://clauxen-app.shirova.workers.dev" },
  "services": [{ "binding": "APP", "service": "clauxen-app" }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [
      { "binding": "AUTOMATION_QUEUE", "queue": "clauxen-app-automation-runs" },
    ],
    "consumers": [
      {
        "queue": "clauxen-app-automation-runs",
        "dead_letter_queue": "clauxen-app-automation-runs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 4,
        "max_retries": 5,
        "retry_delay": 60,
      },
    ],
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
}
