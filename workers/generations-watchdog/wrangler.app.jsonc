{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clauxen-app-watchdog",
  "main": "src/index.ts",
  "account_id": "8fc7a67e9057989309921f362784ecf4",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://clauxen-app.shirova.workers.dev",
    "CONTINUATION_ORIGIN": "https://clauxen-app.shirova.workers.dev",
  },
  "services": [{ "binding": "APP", "service": "clauxen-app" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
}
