{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clauxen-supabase-proxy",
  "main": "src/index.ts",
  "account_id": "8fc7a67e9057989309921f362784ecf4",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "BROKER_PROVIDERS": "github,gitlab" },
  "services": [{ "binding": "OAUTH_BROKER", "service": "clauxen-oauth-broker" }],
  "routes": [{ "pattern": "auth.clauxen.com/*", "zone_name": "clauxen.com" }],
  "ratelimits": [{ "name": "AUTH_RATE_LIMIT", "namespace_id": "2026101702", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true, "redact_query_string": true, "head_sampling_rate": 0.01 },
  "keep_vars": true
}
