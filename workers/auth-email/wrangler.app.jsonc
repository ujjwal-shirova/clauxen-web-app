{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clauxen-auth-email-app",
  "main": "src/index.ts",
  "account_id": "8fc7a67e9057989309921f362784ecf4",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@clauxen.com"] },
  ],
  "kv_namespaces": [
    { "binding": "OTP_STORE", "id": "980848de9e8a45ae86f20b3db8adf222" },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "vars": {
    "FROM_EMAIL": "no-reply@clauxen.com",
    "FROM_NAME": "Clauxen",
    "OTP_TTL_SECONDS": "600",
    "OTP_MAX_ATTEMPTS": "5",
    "OTP_RESEND_COOLDOWN_SECONDS": "60",
    "MAGIC_LINK_TTL_SECONDS": "300",
    "MAGIC_LINK_COOLDOWN_SECONDS": "60",
  },
}
