{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clauxen-connector-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "8fc7a67e9057989309921f362784ecf4",
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "region": "aws:us-west-1",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "APP_ORIGINS": "https://clauxen.com,https://www.clauxen.com,https://*.vercel.app,http://localhost:9002",
    "OAUTH_TRANSACTION_TTL_SECONDS": "600",
    "TOOL_RESPONSE_MAX_BYTES": "1048576",
  },
  "secrets": {
    "required": [
      "CONNECTOR_ENCRYPTION_KEY",
      "CONNECTOR_GATEWAY_INTERNAL_TOKEN",
      "CONNECTOR_GATEWAY_ADMIN_TOKEN",
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "54df64d31cce4e6f8f34415c6fb4e849",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
  "ratelimits": [
    {
      "name": "CONNECTOR_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "CONNECTOR_OAUTH_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "CONNECTOR_TOOL_RATE_LIMITER",
      "namespace_id": "31003",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONNECTOR_EVENTS",
        "queue": "clauxen-connector-events",
      },
    ],
    "consumers": [
      {
        "queue": "clauxen-connector-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "clauxen-connector-events-dlq",
        "max_concurrency": 2,
      },
    ],
  },
}
